<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SmolFurniture</AssemblyName>
    <RootNamespace>SmolFurniture</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <VintageStoryPath Condition="'$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and '$(OS)' == 'Windows_NT'">$(AppData)\Vintagestory</VintageStoryPath>
    <AttributeRenderingLibraryPath Condition="'$(ATTRIBUTE_RENDERING_LIBRARY)' != ''">$(ATTRIBUTE_RENDERING_LIBRARY)</AttributeRenderingLibraryPath>
    <AttributeRenderingLibraryPath Condition="'$(AttributeRenderingLibraryPath)' == '' and Exists('$(VintageStoryPath)\Mods\AttributeRenderingLibrary.dll')">$(VintageStoryPath)\Mods\AttributeRenderingLibrary.dll</AttributeRenderingLibraryPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Vintagestory">
      <HintPath>$(VintageStoryPath)\Vintagestory.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryPath)\VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="VSSurvivalMod">
      <HintPath>$(VintageStoryPath)\Mods\VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="VSEssentials">
      <HintPath>$(VintageStoryPath)\Mods\VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryPath)\Lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="SkiaSharp">
      <HintPath>$(VintageStoryPath)\Lib\SkiaSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="AttributeRenderingLibrary">
      <HintPath>$(AttributeRenderingLibraryPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateVintageStoryPath" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(VintageStoryPath)\VintagestoryAPI.dll')">
    <Error Text="Set VINTAGE_STORY to the Vintage Story installation directory." />
  </Target>

  <Target Name="ValidateAttributeRenderingLibraryPath" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(AttributeRenderingLibraryPath)')">
    <Error Text="Set ATTRIBUTE_RENDERING_LIBRARY to the path of AttributeRenderingLibrary.dll." />
  </Target>

</Project>
